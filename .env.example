# Keep credentials server-side. Restart npm run dev after changes.
PORT=5173
SERPAPI_API_KEY=
OPENALEX_API_KEY=
# Your Nosana deployment's OpenAI-compatible base URL, including /v1.
# Leave blank until your deployment is running.
LLM_BASE_URL=
# Optional when /v1/models returns exactly one chat model; otherwise set its ID.
LLM_MODEL=
LLM_API_KEY=
# Optional settings for reasoning models and slower GPU deployments.
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_MS=120000
# Optional: only set if your deployment serves an embeddings model.
# BM25 retrieval works without a separate embedding model.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Real sandbox execution; default Daytona Cloud URL and organization region are used.
DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us
# Hosted demo only: bind externally, allow the public origin, and protect mutations.
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://your-daytona-preview-host
# DEMO_ACCESS_CODE=use-a-long-random-code
# POCKETLAB_DATA_DIR=/home/daytona/pocketlab-data
